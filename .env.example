DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/laveranda
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Optional: test database used by `npm run db:test:setup`.
# Defaults to the DATABASE_URL database name + "_test" (e.g. laveranda_test).
DATABASE_URL_TEST=

# Optional: `npm run seed` creates this admin user when the database has no users
# (useful after `npm run db:reset`). Leave empty to create the admin at /admin instead.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Email (SMTP). Gmail: turn on 2-Step Verification and create an App Password.
# Leave SMTP_USER/SMTP_PASS empty to skip emails (they are logged instead).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=La Veranda Restaurant

# Cloudflare Turnstile spam check. These are Cloudflare's public always-pass TEST keys;
# use real keys in production. Leave both empty to turn the check off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
