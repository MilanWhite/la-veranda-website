DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/laveranda
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Optional: test database used by `npm run db:test:setup`.
# Defaults to the DATABASE_URL database name + "_test" (e.g. laveranda_test).
DATABASE_URL_TEST=

# Optional: `npm run seed` creates this admin user when the database has no users
# (useful after `npm run db:reset`). Leave empty to create the admin at /admin instead.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Public URL of the site (links in emails and calendar events)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Email: the first option that's fully set is used. Emails are sent from EMAIL_FROM.
# Check with: npm run check:email -- you@example.com

# Email, option 1: Cloudflare Email Sending (HTTPS, no mailbox password; works on Railway and
# locally). The domain of EMAIL_FROM must be onboarded in Cloudflare → Email Service → Email
# Sending. Token: an account API token with only "Email Sending: Edit".
# In the Cloudflare dashboard, turn on "Drop suppressed recipients" for the sending domain.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_TOKEN=

# Email, option 2: the email relay, a Cloudflare Worker (see email-relay/) that sends through
# Gmail SMTP. EMAIL_RELAY_SECRET must match the Worker's RELAY_SECRET.
# With option 1 set, keep these set too: any email Cloudflare can't send goes out this way.
EMAIL_RELAY_URL=
EMAIL_RELAY_SECRET=

# Email, option 3: SMTP directly. Gmail: turn on 2-Step Verification and create an App
# Password. With no option set, emails are skipped (logged instead).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=La Veranda Restaurant

# Google Calendar (approved events). Service account JSON key: client_email + private_key.
# Share the calendar with the service account ("Make changes to events").
# The calendar ID can also be set in Admin → Site Settings → Internal.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# Optional: opening hours from Google (Places API, New). Empty = hours from Site Settings.
# Only the key is needed; the restaurant is found by GOOGLE_PLACE_QUERY (default: La Veranda's
# name and address). Check with: npm run check:google-hours
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACE_QUERY=

# Cloudflare Turnstile spam check. These are Cloudflare's public always-pass TEST keys;
# use real keys in production. Leave both empty to turn the check off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
